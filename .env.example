DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-non-local-environments
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
DJANGO_DEBUG=true

POSTGRES_DB=coworkhub
POSTGRES_USER=coworkhub
POSTGRES_PASSWORD=coworkhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://coworkhub:coworkhub@postgres:5432/coworkhub

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Portas publicadas apenas no ambiente local.
WEB_PORT=8000
POSTGRES_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6379

# Ajuste se o usuário do host possuir outro UID/GID (`id -u` e `id -g`).
LOCAL_UID=1000
LOCAL_GID=1000
