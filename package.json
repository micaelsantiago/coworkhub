{
  "name": "coworkhub-frontend",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --minify",
    "build:js": "esbuild ./assets/js/app.js --bundle --minify --outfile=./static/js/app.js",
    "dev": "concurrently --kill-others \"npm:watch:css\" \"npm:watch:js\"",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --watch",
    "watch:js": "esbuild ./assets/js/app.js --bundle --outfile=./static/js/app.js --watch"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.17.4",
    "@alpinejs/focus": "^3.17.4",
    "alpinejs": "^3.15.0",
    "htmx.org": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.11",
    "tailwindcss": "4.3.0"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.6.0"
  }
}
